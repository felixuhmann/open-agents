# Dependencies and build artifacts (rebuilt inside the image)
node_modules
**/node_modules
**/dist
packages/db/generated

# Local env and secrets
.env
.env.*
!.env.example
apps/api/.env
docker/.env

# Git and editor
.git
.gitignore
.cursor
.agents
**/.DS_Store

# Docs and dev-only assets (not needed in the runtime image)
docs
*.md
!apps/api/src/emails/**
# ...except the control-plane skill folder: `apps/api` build compiles it into
# the runtime `.skill` download (dist/skills/), so it must reach the context.
!docs/skills/open-agents-control-plane
!docs/skills/open-agents-control-plane/**

# Test and CI
**/*.test.ts
**/*.spec.ts
coverage
.turbo
