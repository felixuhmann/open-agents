# Copy to docker/.env, set every blank required value, then invoke Compose with
# `--env-file docker/.env` so values are available for interpolation.
#
#   cp docker/.env.example docker/.env

# Host port mapped to the app container (default 3000).
APP_PORT=3000

# Public URLs — use your real domain in production (no trailing slash).
PUBLIC_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000

# Bootstrap secrets (generate with `openssl rand -hex 32`).
SECRET_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
UPLOAD_SIGNING_SECRET=

# --- OpenSandbox sandbox runtime (deployment env, not setup-wizard secrets) ---
# Official OpenSandbox Server image. Keep the release pinned; use a digest in
# production after mirroring it into your own registry.
OPENSANDBOX_SERVER_IMAGE=docker.io/opensandbox/server:v0.2.2@sha256:8f8762af7565ed9c6f9dbcf009dd56727aa1fef8ce58a17f2b007b88cfe542bb
# Required shared API key between the app and lifecycle server.
# Generate with `openssl rand -hex 32`.
OPENSANDBOX_API_KEY=
# Pinned guest image built from docker/opensandbox-guest.Dockerfile.
OPENSANDBOX_IMAGE=open-agents-opensandbox-guest:1.0.0

# Optional
LOG_LEVEL=info
AGENT_MODEL_REQUEST_TIMEOUT_SECONDS=300
AGENT_RUN_TIMEOUT_SECONDS=1800
AGENT_STALE_RUN_SECONDS=2100
