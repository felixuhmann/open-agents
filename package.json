{
  "name": "open-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Single-tenant agent platform: Hono + Prisma + pg-boss orchestrator for sandboxed agents, with a Vite/React control plane.",
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "turbo run typecheck lint && pnpm format",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate --ui=tui",
    "db:deploy": "turbo run db:deploy",
    "db:studio": "turbo run db:studio"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.5.6",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
