// open-agents v1 schema.
//
// One deployment == one customer (single-tenant). All rows live in one
// database; there is no Organization scoping.
//
// Owned by `@open-agents/db` workspace package; the generated Prisma client
// is re-exported as `@open-agents/db` and consumed by `apps/api`.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Connection URL is configured in `prisma.config.ts` (Prisma 7+ no longer
// reads `url` from the schema). The provider must still live here so the
// schema language knows which dialect features to allow.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// better-auth managed tables (email/password only).
// Schema mirrors better-auth's expected shape so the prisma adapter binds
// without custom mapping. `User.role` carries our app-level role.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  /// Optional profile details users can share with profile-aware agents.
  phoneNumber   String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  region        String?
  postalCode    String?
  country       String?
  company       String?
  jobTitle      String?
  department    String?
  website       String?
  timezone      String?
  /// Application role: `admin`, `contributor`, or `member`.
  role          String    @default("member")
  /// `false` while the admin-created account hasn't yet set a password.
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions              Session[]
  accounts              Account[]
  oauthApplications     OauthApplication[]
  oauthAccessTokens     OauthAccessToken[]
  oauthConsents         OauthConsent[]
  agentAccess           AgentAccess[]
  conversations         ChatConversation[]
  createdAgents         Agent[]                @relation("AgentCreatedBy")
  reportedIssues        Issue[]                @relation("IssueReporter")
  resolvedIssues        Issue[]                @relation("IssueResolver")
  createdWorkflows      Workflow[]             @relation("WorkflowCreatedBy")
  workflowAccess        WorkflowAccess[]
  workflowConversations WorkflowConversation[]
  scheduledTasks        ScheduledTask[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// better-auth MCP / OIDC provider tables (OAuth connectors for external clients).
// Model names use `Oauth*` (not `OAuth*`) so the Prisma client exposes
// `prisma.oauthApplication` — matching better-auth's expected adapter keys.
// ---------------------------------------------------------------------------

model OauthApplication {
  id           String             @id
  name         String
  icon         String?
  metadata     String?
  clientId     String             @unique
  clientSecret String?
  redirectUrls String
  type         String
  disabled     Boolean            @default(false)
  userId       String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens OauthAccessToken[]
  consents     OauthConsent[]

  @@index([userId])
  @@map("oauthApplication")
}

model OauthAccessToken {
  id                    String           @id
  accessToken           String           @unique
  refreshToken          String           @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  clientId              String
  userId                String?
  scopes                String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  client                OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id           String           @id
  clientId     String
  userId       String
  scopes       String
  consentGiven Boolean
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  client       OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

// ---------------------------------------------------------------------------
// Deployment-wide non-secret settings (e.g. email footer logo URL).
// Plain key/value strings — anything sensitive belongs in `Secret`.
// ---------------------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Service / per-tool secrets store.
// Encrypted with AES-256-GCM keyed by `SECRET_ENCRYPTION_KEY` from env.
// ---------------------------------------------------------------------------

model Secret {
  id             String            @id @default(cuid())
  /// `service` (e.g. anthropic_api_key, mailgun_api_key) or `tool` (per-binding).
  scope          String
  /// Stable lookup key inside its scope. For `service` this is e.g.
  /// `anthropic_api_key`; for `tool` this is e.g. `bearer` or `notion_token`.
  key            String
  encryptedValue Bytes
  iv             Bytes
  authTag        Bytes
  /// Set when scope = `tool`; FK to AgentToolBinding.
  toolBindingId  String?
  toolBinding    AgentToolBinding? @relation(fields: [toolBindingId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([scope, key, toolBindingId])
  @@index([toolBindingId])
}

// ---------------------------------------------------------------------------
// Agent definition.
// One row per agent in this deployment.
// ---------------------------------------------------------------------------

model Agent {
  id             String  @id @default(cuid())
  /// URL slug, also the local part of the agent's inbound email by default.
  slug           String  @unique
  displayName    String
  description    String?
  /// Optional free-form category used to group and filter agents in the control plane.
  category       String?
  /// Suggested first messages shown in the web chat empty state (JSON string array).
  starterPrompts Json    @default("[]")
  /// Stored avatar reference. Three flavours are accepted:
  ///   - `/static/uploads/avatars/<file>` — admin upload through the SPA
  ///     (file lives under `apps/api/data/uploads/avatars/`);
  ///   - bare filename — legacy reference into the bundled
  ///     `apps/api/src/emails/static/` directory;
  ///   - `https://...` — externally-hosted image.
  /// `NULL` means "use the shared `fallback.png`". See
  /// `apps/api/src/services/renderEmail.ts#resolveAssetUrl` for how the
  /// value is normalised at render time.
  avatar         String?
  /// Optional agent system prompt used by Daytona runs and mirrored in the editor.
  systemPrompt   String  @default("")
  /// Pi-ai provider id (e.g. `anthropic`, `openai`, `openrouter`).
  modelProvider  String  @default("anthropic")
  /// Model id within the provider catalog (e.g. `claude-opus-4-7`, `gpt-4o-mini`).
  modelId        String  @default("claude-opus-4-7")
  /// Provider-neutral Pi reasoning effort; published versions freeze this value.
  reasoningLevel String  @default("high")

  emailEnabled         Boolean @default(false)
  webEnabled           Boolean @default(true)
  /// `everyone` (any deployment user can chat) or `specific` (only users in AgentAccess).
  accessMode           String  @default("everyone")
  /// Local part for inbound mail (`<inboundLocalPart>@<MAILGUN_DOMAIN>`).
  /// Defaults to the slug; admin can override.
  inboundLocalPart     String  @unique
  /// When true, runtime prompts include the profile for the user who authored
  /// the current request (web conversations directly, email by matching sender).
  profileAccessEnabled Boolean @default(false)

  /// Capability token for the optional anonymous web-chat share link.
  /// `NULL` disables public access immediately; rotating it invalidates all
  /// previously issued links and their browser-local conversations.
  publicShareToken String? @unique

  /// Draft sandbox network policy (internet, allowlist, internal protection).
  /// Published copies are frozen in `AgentVersion.payload.runtime.sandbox`.
  sandboxNetworkPolicy Json?
  /// Draft command policy (deny rules, approval gates, limits).
  sandboxCommandPolicy Json?

  /// Latest published (frozen) runtime config. Runs pin `AgentVersion` rows;
  /// this pointer is the admin-facing "live" version for new runs.
  currentVersionId String?       @unique
  currentVersion   AgentVersion? @relation("AgentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("AgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions      AgentVersion[]      @relation("AgentVersions")
  access        AgentAccess[]
  toolBindings  AgentToolBinding[]
  skillBindings AgentSkillBinding[]
  mcpBindings   AgentMcpBinding[]
  /// Other agents this agent may delegate to via the `run_subagent` tool.
  subagentBindings AgentSubagentBinding[] @relation("AgentSubagentParent")
  /// Bindings where this agent is the callee (which agents can delegate to it).
  subagentOf       AgentSubagentBinding[] @relation("AgentSubagentChild")
  memoryDocs    MemoryDoc[]
  conversations ChatConversation[]
  emailThreads  EmailThread[]
  runs          AgentRun[]
  issues        Issue[]
  scheduledTasks ScheduledTask[]
  sandboxes     AgentSandbox[]
  workflowSteps WorkflowStep[]

  @@index([createdById])
  @@index([category])
}

/// Immutable snapshot of agent runtime config at publish time. `payload` is the
/// source of truth for auditing runs.
model AgentVersion {
  id              String     @id @default(cuid())
  agentId         String
  agent           Agent      @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  currentForAgent Agent?     @relation("AgentCurrentVersion")
  /// Monotonic per-agent publish counter (1, 2, 3, …).
  versionNumber   Int
  /// Provider-neutral frozen config (system prompt, tools, skills, runtime).
  payload         Json
  createdAt       DateTime   @default(now())
  runs            AgentRun[]

  @@unique([agentId, versionNumber])
  @@index([agentId])
}

/// Per-agent ACL row. Only consulted when Agent.accessMode = `specific`.
model AgentAccess {
  agentId String
  userId  String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([agentId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Tools and skills (org-wide library, attachable to any agent).
// ---------------------------------------------------------------------------

/// Unified tool catalog. Every agent capability is a `Tool` row. The
/// `runtime` discriminates who runs the code:
///
/// - `managed` — runs inside the Daytona sandbox (`bash`, `read`, `write`,
///   `edit`, `glob`, `grep`, `web_fetch`, `web_search`).
/// - `platform` — runs on our backend through Pi host-side tool bindings.
///
/// Deployment-wide third-party MCP server registry.
model McpServer {
  id           String            @id @default(cuid())
  name         String            @unique
  label        String
  description  String?
  serverUrl    String
  bearerCipher Bytes?
  bearerIv     Bytes?
  bearerTag    Bytes?
  bindings     AgentMcpBinding[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model AgentMcpBinding {
  agentId     String
  mcpServerId String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  mcpServer   McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([agentId, mcpServerId])
  @@index([mcpServerId])
}

model Tool {
  id              String             @id @default(cuid())
  /// Stable identifier. For `managed`: the toolset member name (`bash`,
  /// `read`, …). For `platform`: the `PlatformHandler.key`.
  key             String             @unique
  /// Display name shown in the UI catalog (e.g. "Workspace memory").
  name            String
  /// One-paragraph description rendered in the tool picker / catalog page.
  description     String
  /// `managed` or `platform` — see model doc-comment.
  runtime         String             @default("platform")
  /// JSON shape describing per-binding configuration (rendered as a form
  /// in the agent edit page). Empty object when there's nothing to configure.
  configSchema    Json               @default("{}")
  /// Whether this tool needs at least one Secret value per binding.
  requiresSecrets Boolean            @default(false)
  /// Marks tools that no longer back a live capability. Existing bindings keep
  /// working until an admin migrates; the picker hides deprecated rows.
  deprecated      Boolean            @default(false)
  bindings        AgentToolBinding[]
  createdAt       DateTime           @default(now())
}

/// Binding row joining an Agent to a `Tool` (any runtime). Per-agent
/// overrides live in `configJson`; per-binding secret rows live in Secret
/// with `toolBindingId` set.
model AgentToolBinding {
  id         String   @id @default(cuid())
  agentId    String
  toolId     String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  configJson Json     @default("{}")
  secrets    Secret[]
  createdAt  DateTime @default(now())

  @@unique([agentId, toolId])
  @@index([toolId])
}

/// Stable skill family shown in the library. Bundle uploads are immutable
/// SkillVersion rows so agents can pin or switch versions independently.
model Skill {
  id          String              @id @default(cuid())
  name        String              @unique
  description String?
  versions    SkillVersion[]
  bindings    AgentSkillBinding[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

/// Immutable uploaded bundle for a Skill. The local `bundleStorageRef` points
/// to the on-disk zip materialized into Daytona sandboxes.
model SkillVersion {
  id               String              @id @default(cuid())
  skillId          String
  versionNumber    Int
  /// Original upload filename for display/debugging.
  filename         String
  /// Local relative path inside `apps/api/data/skills/` of the bundle zip.
  bundleStorageRef String
  skill            Skill               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  bindings         AgentSkillBinding[]
  createdAt        DateTime            @default(now())

  @@unique([skillId, versionNumber])
  @@index([skillId])
}

/// One-shot, short-lived authorization to upload a skill bundle out-of-band —
/// the "signed URL" target backing the `skills_create` MCP tool. The raw token
/// is returned once inside the upload URL and never stored; only its SHA-256
/// hash is persisted here. A successful upload (or passing `expiresAt`)
/// invalidates the row, so a leaked or replayed URL cannot create a second
/// version.
model PendingSkillUpload {
  id          String    @id @default(cuid())
  /// SHA-256 hash (hex) of the opaque upload token. The raw token is never stored.
  tokenHash   String    @unique
  /// Target skill name. If a Skill with this name exists at upload time the
  /// bundle becomes a new version; otherwise a new Skill is created.
  skillName   String
  /// Description applied only when the upload creates a brand-new skill.
  description String?
  expiresAt   DateTime
  /// Set atomically on the first successful upload; guarantees single use.
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
}

/// Directed "can delegate to" edge between two agents. When agent A binds
/// agent B, A's runtime gains a `run_subagent` option targeting B. The callee's
/// published version is frozen into A's `AgentVersion.payload.subagentBindings`
/// at publish time (mirrors how WorkflowStep pins agent versions), so live
/// delegations are reproducible even as B is edited afterward.
model AgentSubagentBinding {
  agentId    String
  subagentId String
  agent      Agent    @relation("AgentSubagentParent", fields: [agentId], references: [id], onDelete: Cascade)
  subagent   Agent    @relation("AgentSubagentChild", fields: [subagentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([agentId, subagentId])
  @@index([subagentId])
}

/// Many-to-many between Agent and Skill, pinned to one uploaded version.
model AgentSkillBinding {
  agentId        String
  skillId        String
  skillVersionId String
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill          Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillVersion   SkillVersion @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([agentId, skillId])
  @@index([skillId])
  @@index([skillVersionId])
}

// ---------------------------------------------------------------------------
// Generic memory tool storage. JSON-doc collections scoped to one agent.
// ---------------------------------------------------------------------------

model MemoryDoc {
  id         String   @id @default(cuid())
  agentId    String
  /// Logical collection name (e.g. `customer_notes`).
  collection String
  /// Free-form JSON document.
  doc        Json
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([agentId, collection])
}

// ---------------------------------------------------------------------------
// Provider sandbox lifecycle (Daytona, etc.). Session ids on conversations
// and threads still point at `sessionId`; this table is the source of truth
// for sandbox metadata, state, and operator controls.
// ---------------------------------------------------------------------------

model AgentSandbox {
  id                String    @id @default(cuid())
  /// Provider identifier, e.g. `daytona`.
  provider          String
  /// Sandbox id in the provider control plane.
  providerSandboxId String
  /// Backend session id (`daytona:{agentId}:{providerSandboxId}`).
  sessionId         String    @unique
  /// Mirror of provider state (`started`, `stopped`, `archived`, `error`, …).
  state             String    @default("unknown")
  agentId           String
  /// `chat` | `email` when bound to a surface.
  surface           String?
  conversationId    String?   @unique
  threadId          String?   @unique
  /// Lifecycle policy at creation: autoStop/Archive/Delete intervals (minutes).
  lifecyclePolicy   Json
  lastActivityAt    DateTime  @default(now())
  lastSyncedAt      DateTime?
  errorReason       String?
  recoverable       Boolean?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  agent        Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  thread       EmailThread?      @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@unique([provider, providerSandboxId])
  @@index([agentId])
  @@index([state, lastActivityAt])
}

// ---------------------------------------------------------------------------
// Web chat persistence (separate from email).
// ---------------------------------------------------------------------------

model ChatConversation {
  id        String        @id @default(cuid())
  agentId   String
  /// Authenticated owner. Public share-link conversations deliberately have
  /// no deployment user and are instead protected by `publicAccessTokenHash`.
  userId    String?
  /// SHA-256 of the browser-local capability token for an anonymous chat.
  publicAccessTokenHash String? @unique
  /// Backend session id currently bound to this conversation.
  sessionId String?       @unique
  title     String        @default("New chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  agent     Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  runs      AgentRun[]
  issues    Issue[]
  sandbox           AgentSandbox?
  scheduledTaskRuns ScheduledTaskRun[]

  @@index([agentId])
  @@index([userId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  /// `user` | `assistant` | `system`.
  role           String
  /// Plain-text or markdown content. For tool events we persist a marker row
  /// only; the canonical event log is RunEvent.
  content        String
  /// Optional FK back to the run that produced this message.
  runId          String?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments    ChatAttachment[]

  @@index([conversationId])
}

/// Files uploaded by the user inside a chat conversation. Persisted as bytes
/// and mounted into the Daytona sandbox on the next run.
model ChatAttachment {
  id            String      @id @default(cuid())
  chatMessageId String
  filename      String
  contentType   String
  sizeBytes     Int
  bytes         Bytes
  backendFileId String?
  mountPath     String?
  createdAt     DateTime    @default(now())
  chatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@index([chatMessageId])
}

// ---------------------------------------------------------------------------
// Run lifecycle (shared between email + chat surfaces).
// ---------------------------------------------------------------------------

model AgentRun {
  id              String            @id @default(cuid())
  agentId         String
  /// Frozen config this run executed against (`Agent.currentVersionId` at enqueue).
  agentVersionId  String?
  agentVersion    AgentVersion?     @relation(fields: [agentVersionId], references: [id], onDelete: SetNull)
  /// `email` | `chat` | `workflow` | `subagent`.
  surface         String
  /// Set when this run was spawned by another run's `run_subagent` tool call.
  /// Points at the parent AgentRun so nested delegations form a tree.
  parentRunId     String?
  /// Set when surface = `email`.
  threadId        String?
  /// Set when surface = `chat`.
  conversationId  String?
  /// Backend session this run executed against.
  sessionId       String
  /// `pending` | `running` | `succeeded` | `failed`.
  status          String            @default("pending")
  error           String?
  /// Final aggregated assistant text. Populated for both surfaces.
  output          String?
  /// Replayable Pi agent context after a successful application turn. Contains
  /// full assistant/tool messages (including provider reasoning metadata), not
  /// just the user-facing text transcript.
  piContext       Json?
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  agent           Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  thread          EmailThread?      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  conversation    ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentRun       AgentRun?         @relation("AgentRunChildren", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns       AgentRun[]        @relation("AgentRunChildren")
  events          RunEvent[]
  attachments     AgentAttachment[]
  workflowStepRun WorkflowStepRun?
  scheduledTaskRuns ScheduledTaskRun[]

  @@index([agentId])
  @@index([agentVersionId])
  @@index([threadId])
  @@index([conversationId])
  @@index([threadId, status, startedAt])
  @@index([conversationId, status, startedAt])
  @@index([parentRunId])
  @@index([status])
}

/// Append-only event log per AgentRun. Powers SSE Last-Event-ID replay
/// and durable web-chat reconnection.
model RunEvent {
  id        BigInt   @id @default(autoincrement())
  runId     String
  /// Monotonic per-run sequence; the SSE handler pages by `seq > Last-Event-ID`.
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, seq])
}

/// Files the agent produced during a run via `attach_run_file`. Attached to
/// outbound email or surfaced in chat.
model AgentAttachment {
  id          String   @id @default(cuid())
  runId       String
  filename    String
  contentType String
  sizeBytes   Int
  bytes       Bytes
  createdAt   DateTime @default(now())
  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// ---------------------------------------------------------------------------
// Inbound email pipeline (rebuilt with agentId FK).
// ---------------------------------------------------------------------------

model EmailThread {
  id             String         @id @default(cuid())
  agentId        String
  userEmail      String
  inboundAddress String?
  subject        String
  rootMessageId  String         @unique
  /// Backend session id this thread is currently bound to.
  sessionId      String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages       EmailMessage[]
  runs           AgentRun[]
  issues         Issue[]
  sandbox        AgentSandbox?

  @@index([agentId])
  @@index([userEmail])
}

model EmailMessage {
  id          String            @id @default(cuid())
  threadId    String
  messageId   String            @unique
  inReplyTo   String?
  /// `inbound` | `outbound`.
  direction   String
  subject     String
  body        String
  createdAt   DateTime          @default(now())
  thread      EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments EmailAttachment[]

  @@index([inReplyTo])
  @@index([threadId])
}

model EmailAttachment {
  id             String       @id @default(cuid())
  emailMessageId String
  filename       String
  contentType    String
  sizeBytes      Int
  bytes          Bytes
  backendFileId  String?
  mountPath      String?
  createdAt      DateTime     @default(now())
  emailMessage   EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
}

// ---------------------------------------------------------------------------
// User-filed issues. A reporter flags a session where an agent or workflow
// misbehaved; admins triage the issue and review the full conversation + raw
// run trace from the SPA.
//
// Exactly one of `conversationId` (surface = chat), `threadId`
// (surface = email), or `workflowConversationId` (surface = workflow) is set.
// ---------------------------------------------------------------------------

model Issue {
  id                     String    @id @default(cuid())
  /// Set for chat/email reports.
  agentId                String?
  /// Set for workflow reports.
  workflowId             String?
  /// `chat` | `email` | `workflow`. Drives which session FK is consulted and
  /// how the SPA renders the conversation history.
  surface                String
  /// Set when surface = `chat`.
  conversationId         String?
  /// Set when surface = `email`.
  threadId               String?
  /// Set when surface = `workflow`.
  workflowConversationId String?
  /// Reporter's User row. Set for chat reports (cookie-authed) and for
  /// email reports when the email matches a known User.
  reporterUserId         String?
  /// Reporter's email. Always set: mirrors User.email for chat reports
  /// or EmailThread.userEmail for email-reported sessions. Used as the
  /// public identifier in the admin list.
  reporterEmail          String
  /// Free-form description of what went wrong.
  description            String
  /// `open` | `resolved`.
  status                 String    @default("open")
  resolvedAt             DateTime?
  resolvedById           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  agent                Agent?                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workflow             Workflow?             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  conversation         ChatConversation?     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  thread               EmailThread?          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  workflowConversation WorkflowConversation? @relation(fields: [workflowConversationId], references: [id], onDelete: Cascade)
  reporter             User?                 @relation("IssueReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  resolvedBy           User?                 @relation("IssueResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([workflowId])
  @@index([conversationId])
  @@index([threadId])
  @@index([workflowConversationId])
  @@index([status])
  @@index([reporterUserId])
}


// ---------------------------------------------------------------------------
// Scheduled tasks: cron-triggered agent/workflow prompts with durable history.
// ---------------------------------------------------------------------------

model ScheduledTask {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// `agent` | `workflow`.
  targetType  String
  agentId     String?
  workflowId  String?
  userId      String
  cron        String
  prompt      String
  /// `active` | `paused`.
  status      String   @default("active")
  timezone    String   @default("UTC")
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent    Agent?             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workflow Workflow?          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs     ScheduledTaskRun[]

  @@index([agentId])
  @@index([workflowId])
  @@index([userId])
  @@index([status, nextRunAt])
}

model ScheduledTaskRun {
  id                     String    @id @default(cuid())
  scheduledTaskId        String
  scheduledFor           DateTime
  /// `pending` | `running` | `succeeded` | `failed`.
  status                 String    @default("pending")
  error                  String?
  conversationId         String?
  workflowConversationId String?
  agentRunId             String?
  workflowRunId          String?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())

  scheduledTask        ScheduledTask        @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)
  conversation         ChatConversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  workflowConversation WorkflowConversation? @relation(fields: [workflowConversationId], references: [id], onDelete: SetNull)
  agentRun             AgentRun?            @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  workflowRun          WorkflowRun?         @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)

  @@index([scheduledTaskId, scheduledFor])
  @@index([status])
  @@index([conversationId])
  @@index([workflowConversationId])
}

// ---------------------------------------------------------------------------
// Workflows: an ordered pipeline of agents. The first step receives the
// user's request; each step's text + file outputs feed the next step's
// input; the last step's output is delivered back to the user. Mirrors the
// Agent model (draft config + published version snapshot), but a workflow
// owns no runtime config of its own — it only references published agents.
// ---------------------------------------------------------------------------

model Workflow {
  id               String  @id @default(cuid())
  /// URL slug for the workflow chat + admin pages.
  slug             String  @unique
  displayName      String
  description      String?
  /// Suggested first messages shown in the workflow chat empty state.
  starterPrompts   Json    @default("[]")
  emailEnabled     Boolean @default(false)
  webEnabled       Boolean @default(true)
  /// `everyone` (any deployment user can run it) or `specific` (WorkflowAccess).
  accessMode       String  @default("everyone")
  /// Local part for inbound mail (`<inboundLocalPart>@<MAILGUN_DOMAIN>`).
  /// Defaults to the slug; admin can override. Must not collide with an Agent.
  inboundLocalPart String  @unique

  /// Latest published (frozen) pipeline snapshot. Runs pin a version.
  currentVersionId String?          @unique
  currentVersion   WorkflowVersion? @relation("WorkflowCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("WorkflowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions      WorkflowVersion[]      @relation("WorkflowVersions")
  steps         WorkflowStep[]
  access        WorkflowAccess[]
  conversations WorkflowConversation[]
  emailThreads  WorkflowEmailThread[]
  runs          WorkflowRun[]
  issues        Issue[]
  scheduledTasks ScheduledTask[]

  @@index([createdById])
}

/// Immutable snapshot of the ordered pipeline at publish time. `payload`
/// freezes each step's agent slug + pinned agent version for auditing.
model WorkflowVersion {
  id                 String    @id @default(cuid())
  workflowId         String
  workflow           Workflow  @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  currentForWorkflow Workflow? @relation("WorkflowCurrentVersion")
  versionNumber      Int
  payload            Json
  createdAt          DateTime  @default(now())

  runs WorkflowRun[]

  @@unique([workflowId, versionNumber])
  @@index([workflowId])
}

/// Draft ordered step. `position` is 0-based; the pipeline runs in ascending
/// order. References a catalog Agent; the agent's published version is frozen
/// into the WorkflowVersion payload at publish time.
model WorkflowStep {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  position   Int
  createdAt  DateTime @default(now())

  @@unique([workflowId, position])
  @@index([workflowId])
  @@index([agentId])
}

/// Per-workflow ACL row. Only consulted when Workflow.accessMode = `specific`.
model WorkflowAccess {
  workflowId String
  userId     String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workflowId, userId])
  @@index([userId])
}

/// Web chat surface for a workflow (mirrors ChatConversation).
model WorkflowConversation {
  id         String   @id @default(cuid())
  workflowId String
  userId     String
  title      String   @default("New chat")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages      WorkflowMessage[]
  runs          WorkflowRun[]
  agentSessions WorkflowAgentSession[]
  issues        Issue[]
  scheduledTaskRuns ScheduledTaskRun[]

  @@index([workflowId])
  @@index([userId])
}

/// User + final-assistant messages shown in the workflow chat. Intermediate
/// step outputs live on WorkflowStepRun, not here.
model WorkflowMessage {
  id             String               @id @default(cuid())
  conversationId String
  /// `user` | `assistant` | `pending_user_upload`.
  role           String
  content        String
  /// FK to the producing WorkflowRun (set on assistant messages).
  workflowRunId  String?
  /// FK to the final step's AgentRun — powers attachment downloads in the UI.
  agentRunId     String?
  createdAt      DateTime             @default(now())
  conversation   WorkflowConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments    WorkflowAttachment[]

  @@index([conversationId])
}

/// Files uploaded by the user in workflow web chat. Mounted into the first
/// pipeline step's sandbox only; later steps receive prior-step outputs.
model WorkflowAttachment {
  id                String          @id @default(cuid())
  workflowMessageId String
  filename          String
  contentType       String
  sizeBytes         Int
  bytes             Bytes
  backendFileId     String?
  mountPath         String?
  createdAt         DateTime        @default(now())
  workflowMessage   WorkflowMessage @relation(fields: [workflowMessageId], references: [id], onDelete: Cascade)

  @@index([workflowMessageId])
}

/// One Daytona session per (workflow conversation or email thread, agent) so
/// each agent keeps its own memory + sandbox across turns.
model WorkflowAgentSession {
  id             String                @id @default(cuid())
  conversationId String?
  emailThreadId  String?
  agentId        String
  sessionId      String                @unique
  createdAt      DateTime              @default(now())
  conversation   WorkflowConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  emailThread    WorkflowEmailThread?  @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)

  @@unique([conversationId, agentId])
  @@unique([emailThreadId, agentId])
  @@index([conversationId])
  @@index([emailThreadId])
}

/// Inbound email surface for a workflow (mirrors EmailThread for agents).
model WorkflowEmailThread {
  id             String                 @id @default(cuid())
  workflowId     String
  userEmail      String
  inboundAddress String?
  subject        String
  rootMessageId  String                 @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  workflow       Workflow               @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  messages       WorkflowEmailMessage[]
  runs           WorkflowRun[]
  agentSessions  WorkflowAgentSession[]

  @@index([workflowId])
  @@index([userEmail])
}

model WorkflowEmailMessage {
  id          String                    @id @default(cuid())
  threadId    String
  messageId   String                    @unique
  inReplyTo   String?
  /// `inbound` | `outbound`.
  direction   String
  subject     String
  body        String
  createdAt   DateTime                  @default(now())
  thread      WorkflowEmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments WorkflowEmailAttachment[]

  @@index([inReplyTo])
  @@index([threadId])
}

model WorkflowEmailAttachment {
  id                     String               @id @default(cuid())
  workflowEmailMessageId String
  filename               String
  contentType            String
  sizeBytes              Int
  bytes                  Bytes
  backendFileId          String?
  mountPath              String?
  createdAt              DateTime             @default(now())
  workflowEmailMessage   WorkflowEmailMessage @relation(fields: [workflowEmailMessageId], references: [id], onDelete: Cascade)

  @@index([workflowEmailMessageId])
}

/// One run of the whole pipeline for a single user turn.
model WorkflowRun {
  id                String                @id @default(cuid())
  workflowId        String
  /// Frozen pipeline this run executed against (`Workflow.currentVersionId` at enqueue).
  workflowVersionId String?
  /// Set when the run originated from web chat.
  conversationId    String?
  /// Set when the run originated from inbound email.
  emailThreadId     String?
  /// `pending` | `running` | `succeeded` | `failed`.
  status            String                @default("pending")
  error             String?
  /// Final (last step) aggregated text delivered to the user.
  output            String?
  startedAt         DateTime              @default(now())
  completedAt       DateTime?
  workflow          Workflow              @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion   WorkflowVersion?      @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)
  conversation      WorkflowConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  emailThread       WorkflowEmailThread?  @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)
  events            WorkflowRunEvent[]
  stepRuns          WorkflowStepRun[]
  scheduledTaskRuns ScheduledTaskRun[]

  @@index([workflowId])
  @@index([conversationId])
  @@index([emailThreadId])
  @@index([status])
}

/// One step (agent turn) within a WorkflowRun. Links to the backing AgentRun
/// so the existing trace / attachment tooling keeps working per step.
model WorkflowStepRun {
  id             String      @id @default(cuid())
  workflowRunId  String
  position       Int
  agentId        String
  agentSlug      String
  agentVersionId String?
  /// FK to the backing AgentRun (surface = `workflow`).
  runId          String?     @unique
  /// `pending` | `running` | `succeeded` | `failed`.
  status         String      @default("pending")
  /// Text fed into this step (user request for step 0, prior output otherwise).
  inputText      String?
  output         String?
  error          String?
  createdAt      DateTime    @default(now())
  workflowRun    WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  run            AgentRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([workflowRunId])
  @@index([runId])
}

/// Append-only event log per WorkflowRun. Powers the workflow chat SSE
/// (step timeline + forwarded token deltas) with Last-Event-ID replay.
model WorkflowRunEvent {
  id            BigInt      @id @default(autoincrement())
  workflowRunId String
  seq           Int
  type          String
  payload       Json
  createdAt     DateTime    @default(now())
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@unique([workflowRunId, seq])
  @@index([workflowRunId, seq])
}
